{
  "hosting": {
    "public": "frontend/html",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Plataforma de Votación",
        "supportEmail": "julieth.mena@campusucc.edu.co",
        "authorizedRedirectUris": [
          "https://plataformadevotacion.firebaseapp.com/__/auth/handler",
          "http://localhost"
        ]
      }
    }
  }
}

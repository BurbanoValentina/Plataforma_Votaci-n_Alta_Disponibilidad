# ==============================================================================
# PLATAFORMA DISTRIBUIDA DE VOTACIÓN DE ALTA DISPONIBILIDAD
# PLANTILLA DE VARIABLES DE ENTORNO — ARQUITECTURA LIMPIA (.env.example)
# ==============================================================================

# 1. Base de Datos Transaccional (PostgreSQL 15 Alpine)
DB_NAME=voting_db
DB_USER=voting_user
DB_PASSWORD=SuperSecurePass2026!
DB_PORT=5432

# 2. Broker de Eventos y Fuente de Verdad (Apache Kafka KRaft Mode)
KAFKA_PORT=9092
KAFKA_HOST_PORT=29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# 3. Distribución Reactiva de Mensajería (RabbitMQ 3.12 Management)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# 4. Puertos y Balanceo de Red (Gateway Nginx y Edge Nodes)
FRONTEND_PORT=80
BACKEND_EDGE_PORT=8080
STREAM_PROCESSOR_PORT=8081

# 5. Gobernanza de Recursos en el Kernel de Linux (JVM + cgroups)
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# ========================================================
# PLATAFORMA DE VOTACIÓN DE ALTA DISPONIBILIDAD
# VARIABLES DE ENTORNO — ARQUITECTURA DISTRIBUIDA (EJEMPLO)
# ========================================================

# Base de Datos PostgreSQL
DB_NAME=voting_db
DB_USER=voting_user
DB_PASSWORD=your_secure_password_here
DB_PORT=5432

# Mensajería RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Apache Kafka & Zookeeper
KAFKA_PORT=9092
KAFKA_HOST_PORT=29092
ZOOKEEPER_PORT=2181

# Puertos de Exposición Host
FRONTEND_PORT=80
VOTING_API_PORT=8085
GLOBAL_DASHBOARD_PORT=8082
REGIONAL_DASHBOARD_PORT=8083

# Parámetros JVM Contenerizados
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
